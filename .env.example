# ============================================================
# MATCHBOOK ASYNC INFRASTRUCTURE
# ============================================================

# RabbitMQ / CloudAMQP
MATCHBOOK_CELERY_BROKER_URL=amqps://USERNAME:PASSWORD@HOST/VHOST

# Redis
MATCHBOOK_REDIS_URL=redis://USERNAME:PASSWORD@HOST:PORT/0

# Celery task result backend
MATCHBOOK_CELERY_RESULT_BACKEND=redis://USERNAME:PASSWORD@HOST:PORT/1

# Matching cache
MATCHBOOK_MATCH_CACHE_TTL_SECONDS=300